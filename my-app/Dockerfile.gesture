FROM python:3.11-slim

# OpenCV system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libgstreamer1.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/app/gesture_server.py .
COPY src/app/hand_landmarker.task .
# face_landmarker.task is optional — server gracefully disables face mode if absent
COPY src/app/face_landmarker.task* ./

ENV ALLOWED_ORIGINS="http://localhost:3444"

EXPOSE 8000

CMD ["uvicorn", "gesture_server:app", "--host", "0.0.0.0", "--port", "8000"]
